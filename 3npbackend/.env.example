# Copy to .env and fill in. .env is git-ignored; never commit real values.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# true auto-creates/alters tables from entities. Use only for local development.
DB_SYNCHRONIZE=true
# Random string of at least 32 characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
